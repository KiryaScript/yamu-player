{
  "name": "yamu-player", 
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "author": "Devik",
  "description": "YAMU - Advanced Yandex Music Client",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "electron": "wait-on http://localhost:5173 && electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.yamu.player",
    "productName": "YAMU",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "icon.ico" 
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "YAMU-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "YAMU"
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "lucide-react": "^0.300.0"
  }
}